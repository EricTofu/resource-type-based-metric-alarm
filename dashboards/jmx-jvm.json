{
  "widgets": [
    {
      "height": 6,
      "properties": {
        "metrics": [
          [
            {
              "expression": "SELECT AVG(jvm_memory_heap_used) FROM \"CWAgent\" WHERE AppName = 'billing-java-app-1' GROUP BY InstanceId",
              "id": "q1",
              "label": "Heap used"
            }
          ],
          [
            {
              "expression": "SELECT MAX(jvm_memory_heap_max) FROM \"CWAgent\" WHERE AppName = 'billing-java-app-1'",
              "id": "q2",
              "label": "Heap max"
            }
          ]
        ],
        "period": 60,
        "region": "ap-northeast-1",
        "title": "billing-java-app-1 — Heap (bytes)",
        "view": "timeSeries",
        "yAxis": {
          "left": {
            "min": 0
          }
        }
      },
      "type": "metric",
      "width": 8,
      "x": 0,
      "y": 0
    },
    {
      "height": 6,
      "properties": {
        "metrics": [
          [
            {
              "expression": "DIFF(q1)",
              "id": "e1",
              "label": "GC time ms/min"
            }
          ],
          [
            {
              "expression": "SELECT SUM(jvm_gc_collections_elapsed) FROM \"CWAgent\" WHERE AppName = 'billing-java-app-1' GROUP BY InstanceId",
              "id": "q1",
              "visible": false
            }
          ],
          [
            {
              "expression": "DIFF(q2)",
              "id": "e2",
              "label": "GC cycles/min",
              "yAxis": "right"
            }
          ],
          [
            {
              "expression": "SELECT SUM(jvm_gc_collections_count) FROM \"CWAgent\" WHERE AppName = 'billing-java-app-1' GROUP BY InstanceId",
              "id": "q2",
              "visible": false
            }
          ]
        ],
        "period": 60,
        "region": "ap-northeast-1",
        "title": "billing-java-app-1 — GC time (ms/min)",
        "view": "timeSeries",
        "yAxis": {
          "left": {
            "min": 0
          }
        }
      },
      "type": "metric",
      "width": 8,
      "x": 8,
      "y": 0
    },
    {
      "height": 6,
      "properties": {
        "metrics": [
          [
            {
              "expression": "SELECT AVG(jvm_threads_count) FROM \"CWAgent\" WHERE AppName = 'billing-java-app-1' GROUP BY InstanceId",
              "id": "q1",
              "label": "Threads"
            }
          ],
          [
            {
              "expression": "SELECT AVG(jvm_classes_loaded) FROM \"CWAgent\" WHERE AppName = 'billing-java-app-1' GROUP BY InstanceId",
