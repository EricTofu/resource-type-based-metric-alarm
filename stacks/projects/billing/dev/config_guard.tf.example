#------------------------------------------------------------------------------
# config.yaml wiring guard — copy to config_guard.tf on a YAML-wired leaf.
#
# Kept as .tf.example because THIS repo's leaves are not YAML-wired: main.tf
# still passes `var.<type>_resources`, so there is no `local.res` here and a
# real .tf would fail `terraform validate`. On the work leaf (which reads
# config.yaml via yamldecode — see docs/superpowers/plans/2026-06-09-tfvars-to-
# yaml-wiring.md) drop the .example suffix, or paste the two blocks into
# config.tf next to the `local.res` definition.
#
# WHAT IT CATCHES
#
# Two checks, same failure. First: a `resources:` key that no module block
# consumes. Second: a TOP-LEVEL key nothing reads — the identity keys and
# cwagent_configs live there, outside `resources:`, and were invisible to the
# original guard.
#
# A `resources:` key that no module block consumes. Terraform has nothing to say
# about it: `try(local.res.jmx, [])` in a module block that was never added
# simply does not exist, so the key is read by nobody and the plan is clean.
# The alarms are never created, and — worse — the library module's `validation`
# blocks never run, so a typo'd identity value or a missing heap_max_bytes is not
# reported either. Nothing is created, nothing is wrong, nothing is said.
#
# This is exactly how `jmx:` sat inert on the work leaf (2026-07-31): the leaf
# was YAML-wired ~2026-06-10, and every type wired into main.tf after that date
# (efs 2026-06-24, jmx 2026-07-30) arrived reading a `var.*` the YAML never
# fills. The `count = length(...) > 0 ? 1 : 0` guard on each module block then
# reads the `[]` default and drops the module from the graph entirely.
#
# MAINTENANCE
#
# `wired_resource_types` is a hand-maintained mirror of the module blocks in
# main.tf. Terraform cannot enumerate its own module blocks, so the list cannot
# be derived — adding a type to main.tf means adding its key here in the same
# commit. A type present in main.tf but missing from this list is the one case
# this guard cannot see: it produces a false alarm (a working key reported as
# unconsumed), which is loud and gets fixed, not a silent hole.
#------------------------------------------------------------------------------

locals {
  # Every `resources:` key that some module block in main.tf actually reads.
  # Keep in sync with main.tf; see step 4 of "Adding a New Resource Type" in
  # CLAUDE.md.
  wired_resource_types = [
    "alb",
    "apigateway",
    "asg",
    "cloudfront",
    "ec2",
    "efs",
    "elasticache",
    "jmx",
    "lambda",
    "opensearch",
    "rds",
    "s3",
    "ses",
  ]

  # Every top-level config.yaml key something in this leaf reads. Same
  # hand-maintained mirror as above, one level up: `cwagent_configs` and the two
  # identity keys are NOT under `resources:`, so the check below is the only
  # thing that notices when main.tf never wires one.
  wired_top_level_keys = [
    "asg_tag_key",
    "aws_region",
    "common_tags",
    "cwagent_configs",
    "cwagent_dimension_key",
    "env",
    "lambda_concurrency_alarm_enabled",
    "lambda_concurrency_threshold",
    "ops_bucket",
    "ops_state_role_arn",
    "project",
    "resources",
  ]

  unconsumed_top_level_keys = sort(setsubtract(keys(local.cfg), local.wired_top_level_keys))

  # keys() on the decoded YAML map, minus the types main.tf consumes. Empty is
  # the healthy state. `local.res` is defined in config.tf as
  # try(local.cfg.resources, {}), so a leaf with no resources: block yields [].
  unconsumed_resource_types = sort(setsubtract(keys(local.res), local.wired_resource_types))
}

# A `check` block reports at the END of a plan and does NOT fail it — the point
# is to break the silence, not to block an apply. If you would rather this be a
# hard error (this failure mode costs you the alarms you thought you deployed),
# delete the check and move the same condition into an output precondition:
#
#   output "config_yaml_guard" {
#     value      = local.unconsumed_resource_types
#     precondition {
#       condition     = length(local.unconsumed_resource_types) == 0
#       error_message = "..."
#     }
#   }
#
# Output preconditions are evaluated at plan time and fail the run. Do not keep
# both: they assert the same thing and would report it twice.
check "config_yaml_keys_are_wired" {
  assert {
    condition = length(local.unconsumed_resource_types) == 0
    error_message = join("", [
      "config.yaml declares resources: key(s) that no module block in main.tf reads: ",
      join(", ", local.unconsumed_resource_types),
      ". Nothing is being created for them and their library-module validations are NOT running. ",
      "Either add the module block (count/resources = try(local.res.<key>, []); see step 4 of ",
      "\"Adding a New Resource Type\" in CLAUDE.md), or delete the key from config.yaml. ",
      "If the block does exist, add its key to local.wired_resource_types in this file.",
    ])
  }
}

check "config_yaml_top_level_keys_are_wired" {
  assert {
    condition = length(local.unconsumed_top_level_keys) == 0
    error_message = join("", [
      "config.yaml declares top-level key(s) that nothing in this leaf reads: ",
      join(", ", local.unconsumed_top_level_keys),
      ". A top-level key is not coerced or validated by any library module, so a typo here ",
      "is silent in both directions — cwagent_configs writes no agent config, asg_tag_key / ",
      "cwagent_dimension_key leave the modules on their defaults while you believe you renamed them. ",
      "Either consume it in main.tf, or delete it. If it IS consumed, add it to ",
      "local.wired_top_level_keys in this file.",
    ])
  }
}
