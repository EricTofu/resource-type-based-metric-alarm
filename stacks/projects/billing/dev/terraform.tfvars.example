project            = "billing"
env                = "dev"
aws_region         = "<PRIMARY_REGION>"
ops_bucket         = "<ORG>-tfstate"
ops_state_role_arn = "<OPS_STATE_ROLE_ARN>"

lambda_concurrency_threshold = 900

common_tags = {
  ManagedBy   = "terraform"
  Environment = "dev"
}

# Fill each list with resources for this project.
# Types the project does not use stay as [].

alb_resources = [
  # {
  #   name = "billing-alb"
  #   # Target group names — required for the UnHealthyHostCount alarm unless
  #   # it is opted out via disabled_alarms.
  #   target_groups = ["billing-alb-tg"]
  #   overrides = {
  #     # Skip specific metric alarms for this resource (opt-out; default = all on).
  #     # Valid ALB IDs: elb_5xx, target_5xx, unhealthy_host
  #     disabled_alarms = ["target_5xx"]
  #   }
  # }
]

apigateway_resources  = []
ec2_resources         = []
lambda_resources      = []
rds_resources         = []
s3_resources          = []
elasticache_resources = []
opensearch_resources  = []
ses_resources         = []
cloudfront_resources  = []

# A fleet is monitored by TWO modules under one identity: asg for capacity and OS
# metrics, jmx for the JVM. Each identity VALUE is named after the system that
# resolves it: asg_tag_value is the resource tag on the instances AND the ASG,
# cwagent_dimension_value is the dimension in the agent config. They are normally
# the same string. The jmx entry is CWAgent-only, so it carries only the latter,
# and it must match the asg entry's to describe the same fleet.
#
# The two KEYS are separate variables, both defaulting to AppName:
#   var.asg_tag_key            the resource tag (capacity + cpu alarms)
#   var.cwagent_dimension_key  the agent dimension (memory/disk, jmx, dashboard)
# See "Renaming either key" in CLAUDE.md before changing either.
asg_resources = [
  # desired_capacity is required on every entry (it is the capacity threshold).
  #
  # Legacy entry: name IS the live ASG name. One alarm, on the
  # AutoScalingGroupName dimension. Valid legacy id: in_service_capacity
  # {
  #   name             = "billing-web-asg"
  #   desired_capacity = 4
  # },
  #
  # Fleet entry: asg_tag_value switches the entry to identity-scoped Metrics Insights
  # alarms (capacity + per-instance cpu/memory/disk), so CodeDeploy blue/green
  # churn of instance IDs and the ASG name needs no re-apply. Here `name` is only
  # a logical label for alarm naming; the two *_value fields are the identity.
  #
  # WARNING: latching fleet mode on an entry that is already applied requires TWO
  # applies (remove entry -> apply -> re-add with the values -> apply). Both modes
  # render the same GroupInServiceCapacity alarm name; a single plan would
  # create and delete it concurrently. See modules/.../asg/main.tf.
  {
    name                    = "billing-chat-fleet"
    desired_capacity        = 3
    asg_tag_value           = "billing-chat-live" # the <asg_tag_key> tag on the ASG + instances
    cwagent_dimension_value = "billing-chat-live" # the <cwagent_dimension_key> dimension in the agent config
    overrides = {
      cpu_threshold  = 90
      disk_threshold = 80
      # Valid fleet ids: in_service_capacity, cpu, memory, disk
      disabled_alarms = ["memory"]
    }
  },
]

# valid jmx ids: heap_used, gc_time. heap_max_bytes = JVM -Xmx in bytes, required
# unless heap_used is disabled (the alarm is a byte threshold); scripts/resolve_heap_max.sh
# emits it from live telemetry. process_group scopes the queries when a host runs more
# than one JVM. `name` is a label only.
jmx_resources = [
  {
    name                    = "billing-chat-fleet"
    cwagent_dimension_value = "billing-chat-live" # same value as the asg entry above
    heap_max_bytes          = 12884901888         # -Xmx12G
    process_group           = "chat-server-tomcat"
    overrides = {
      gc_time_threshold_ms = 12000 # 20% of wall clock, for a GC-heavy service
    }
  },
  # standalone Java hosts may share one identity; the entry then covers all of
  # them, alarming when ANY instance breaches (GROUP BY InstanceId)
  {
    name                    = "billing-batch-java"
    cwagent_dimension_value = "billing-batch"
    heap_max_bytes          = 4294967296 # -Xmx4G
    overrides = {
      heap_threshold = 80
    }
  },
]

efs_resources = [
  { file_system_id = "fs-0123456789abcdef0", name = "billing-shared-efs" },
  {
    file_system_id = "fs-0fedcba9876543210"
    name           = "billing-reports-efs"
    overrides      = { throughput_util_threshold = 70, evaluation_periods = 12, severity = "ERROR" }
  },
]

# CloudWatch Agent configs published to SSM Parameter Store, one per host group.
# The module's base template covers host metrics (cpu/mem/disk/net/...); each
# entry's `template` under cwagent/ carries this app's logs + jmx blocks.
# cwagent_dimension_value is the identity the alarms match: keep it equal to the
# asg/jmx entries above (and normally to the ASG's asg_tag_value too). It is the
# ONLY dimension the module writes; ProcessGroupName and anything else an app
# needs lives in the overlay, beside the plugin it describes.
# Applying this does NOT restart any agent — hosts report under the old identity
# until they re-fetch, and CWAgent-sourced alarms sit green in the meantime.
cwagent_configs = [
  {
    name                    = "billing-chat-fleet"
    cwagent_dimension_value = "billing-chat-live" # same value as the asg/jmx entries
    template                = "chat.json.tftpl"   # owns logs + jmx + ProcessGroupName
  },
  {
    name                    = "billing-batch-java"
    cwagent_dimension_value = "billing-batch"
    template                = "batch.json.tftpl"
  },
  # No template: host metrics only — no JVM, no log shipping.
  {
    name                    = "billing-bastion"
    cwagent_dimension_value = "billing-bastion"
  },
]
