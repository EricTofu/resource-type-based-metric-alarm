# ============================================================================
# config.yaml — committed deploy intent for this leaf (replaces terraform.tfvars)
# ----------------------------------------------------------------------------
# Copy to config.yaml and edit. This file IS committed (YAML is not a *.tfvars,
# so it is exempt from the org "no tfvars in git" rule). The leaf reads it via
#   yamldecode(file("${path.module}/config.yaml"))
# Resource-list values are coerced + defaulted + validated at the library
# module boundary, so omit anything that only takes its default.
# ============================================================================

# ─── Stack wiring (was the scalar vars in terraform.tfvars) ─────────────────
project:            billing
env:                dev
aws_region:         ap-northeast-1
ops_bucket:         <ORG>-tfstate
ops_state_role_arn: arn:aws:iam::<OPS_ACCOUNT_ID>:role/tf-state-access
# SNS topics (create vs import) are a PLATFORM stack concern — this leaf only
# reads the resulting ARNs from platform remote state. Configure sns_choice /
# existing_sns_arns in stacks/platform/<env>/, not here.
lambda_concurrency_threshold: 900     # account-level concurrency alarm threshold
# lambda_concurrency_alarm_enabled: true
# The fleet identity's two KEYS. Both default to AppName and are NOT the same
# thing — see "Identity carriers" in CLAUDE.md. The identity VALUE is per-entry
# (asg_tag_value / cwagent_dimension_value, under resources: below); only the
# keys live here.
#
#   asg_tag_key            AWS resource tag on the ASG + instances.
#                          asg capacity and cpu alarms only.
#   cwagent_dimension_key  dimension stamped by the CloudWatch Agent.
#                          asg memory/disk, all jmx alarms, dashboard widgets.
#
# A YAML leaf must ALSO consume each in main.tf, e.g.
#   asg_tag_key = try(local.cfg.asg_tag_key, "AppName")
# config_guard.tf only inspects keys under `resources:`, so an unconsumed
# top-level scalar sits here silently doing nothing.
# asg_tag_key:           AppName
# cwagent_dimension_key: AppName
common_tags:
  ManagedBy:   terraform
  Environment: dev
  Stack:       projects/billing

# ─── What to monitor (was the *_resources lists) ───────────────────────────
# One key per resource type, named without the "_resources" suffix.
# Omit a key entirely (or use []) for types this project does not use.
resources:

  alb:
    # target_groups (target group names) is required for the UnHealthyHostCount
    # alarm — the metric only exists per (TargetGroup, LoadBalancer) pair.
    - name: billing-public-alb
      target_groups: [billing-public-tg]
    # tighten one threshold and raise severity
    - name: billing-internal-alb
      target_groups: [billing-internal-tg, billing-internal-admin-tg]
      overrides:
        severity:             ERROR
        target_5xx_threshold: 3
    # opt specific alarms OUT (valid alb ids: elb_5xx, target_5xx, unhealthy_host);
    # with unhealthy_host disabled, target_groups may be omitted
    - name: billing-legacy-alb
      overrides:
        disabled_alarms: [target_5xx, unhealthy_host]

  apigateway:
    - name: billing-public-api
    - name: billing-partner-api
      overrides:
        severity:            CRIT
        error_5xx_threshold: 5
        description:         "Partner-facing API — page on 5xx"

  ec2:
    - name: billing-worker-1
    - name: billing-worker-2
    - name: billing-batch-host
      overrides:
        cpu_threshold:    90
        memory_threshold: 85
        disk_threshold:   80            # disk_used_percent at {InstanceId, path=/}
    # both CWAgent-fed alarms off on an agentless box
    - name: billing-legacy-host
      overrides:
        disabled_alarms:  [memory, disk]

  # A fleet is monitored by TWO modules under one identity: `asg` for capacity and
  # OS metrics, `jmx` for the JVM. Each identity VALUE is named after the system
  # that resolves it: asg_tag_value is the resource tag on the instances AND the
  # ASG, cwagent_dimension_value is the dimension in the agent config. They are
  # normally the same string. The jmx entry is CWAgent-only, so it carries only
  # the latter, and it must match the asg entry's to describe the same fleet.
  #
  # The tag KEY comes from top-level asg_tag_key, the dimension name from
  # cwagent_dimension_key. See "Renaming either key" in CLAUDE.md.
  asg:
    # desired_capacity is REQUIRED (drives the capacity threshold).
    # Legacy entries: name IS the live ASG name. valid legacy id: in_service_capacity
    - name: billing-web-asg
      desired_capacity: 4
    - name: billing-worker-asg
      desired_capacity: 2
      overrides:
        severity:           ERROR
        capacity_threshold: 1
    # Fleet entry: asg_tag_value switches to identity-scoped Metrics Insights alarms
    # (capacity + per-instance cpu/memory/disk), so CodeDeploy blue/green churn
    # of instance IDs and the ASG name needs no re-apply. Here `name` is only a
    # label; the two *_value fields are the identity.
    # WARNING: latching fleet mode on an ALREADY-APPLIED entry needs TWO applies
    # (remove -> apply -> re-add with the values -> apply): both modes render the
    # same GroupInServiceCapacity alarm name, and one plan would create and
    # delete it concurrently. See modules/cloudwatch/metrics-alarm/asg/main.tf.
    - name: billing-chat-fleet
      desired_capacity: 3
      asg_tag_value:           billing-chat-live   # tag on the ASG + instances
      cwagent_dimension_value: billing-chat-live   # dimension in the agent config
      overrides:
        cpu_threshold:   90
        disk_threshold:  80
        # valid fleet ids: in_service_capacity, cpu, memory, disk
        disabled_alarms: [memory]

  # valid jmx ids: heap_used, gc_time. heap_max_bytes = JVM -Xmx in bytes,
  # required unless heap_used is disabled (the alarm is a byte threshold);
  # scripts/resolve_heap_max.sh emits it from live telemetry.
  # process_group scopes the queries when a host runs more than one JVM.
  jmx:
    - name: billing-chat-fleet
      cwagent_dimension_value: billing-chat-live   # same value as the asg entry
      heap_max_bytes: 12884901888        # -Xmx12G
      process_group:  chat-server-tomcat
      overrides:
        gc_time_threshold_ms: 12000      # 20% of wall clock, for a GC-heavy service
    # standalone Java hosts may share one identity; the entry then covers all of
    # them, alarming when ANY instance breaches (GROUP BY InstanceId)
    - name: billing-batch-java
      cwagent_dimension_value: billing-batch
      heap_max_bytes: 4294967296         # -Xmx4G
      overrides:
        heap_threshold: 80

  lambda:
    # timeout_ms is REQUIRED (drives the duration threshold)
    # valid lambda ids: duration, errors, throttles
    - name: billing-invoice-generator
      timeout_ms: 30000
    - name: billing-webhook-handler
      timeout_ms: 5000
      overrides:
        severity:              CRIT
        duration_threshold_ms: 4000
        disabled_alarms:       [throttles]   # e.g. reserved-concurrency spikes are expected

  rds:
    # standalone instance
    - name: billing-primary
      overrides:
        cpu_threshold:                  80
        database_connections_threshold: 400
    # Aurora cluster — is_cluster expands to member instances
    - name: billing-aurora
      is_cluster: true
      overrides:
        freeable_memory_threshold_percent: 15
    # Aurora Serverless v2 — adds ACU / capacity alarms
    - name: billing-aurora-sv2
      is_cluster: true
      serverless: true
      overrides:
        acu_utilization_threshold: 85

  s3:
    - name: billing-invoices-bucket
    - name: billing-exports-bucket
      overrides:
        # enables the OperationsFailedReplication alarm; the metric is published
        # per (SourceBucket, DestinationBucket, RuleId), so the destination is
        # required. replication_rule_id defaults to "EntireBucket".
        replication_enabled:            true
        replication_destination_bucket: billing-exports-bucket-replica
        error_5xx_threshold:            10

  elasticache:
    - name: billing-session-cache
      overrides:
        cpu_threshold:    75
        memory_threshold: 80

  # EFS throughput-utilization trend (metric-math alarm, default 6h-sustained >=80%).
  # Identify by file_system_id (fs-xxxx); optional name is for alarm naming only.
  efs:
    - file_system_id: fs-0123456789abcdef0
      name: billing-shared-efs
    # widen the window and tighten the threshold for a busier file system
    - file_system_id: fs-0fedcba9876543210
      name: billing-reports-efs
      overrides:
        throughput_util_threshold: 70
        period:             3600
        evaluation_periods: 12      # 12h sustained
        severity:           ERROR

  opensearch:
    - name: billing-search
      overrides:
        free_storage_threshold: 20480   # MB (FreeStorageSpace unit)
        disabled_alarms:        [old_gen_jvm_memory]

  ses:
    - name: billing-notifications
      overrides:
        bounce_rate_threshold: 5

  cloudfront:
    # cloudfront keys on distribution_id; name is optional (alarm naming only)
    - distribution_id: E1ABCDEF234567
      name: billing-portal-cdn
      overrides:
        description: "Billing portal CDN"
    - distribution_id: E2GHIJKL890123
      overrides:
        severity:                 ERROR
        origin_latency_threshold: 2000   # ms
        error_5xx_threshold:      2
